{% extends 'base.html.twig' %}

{% block title %}Frigate Review{% endblock %}

{% block body %}
    <main class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center gap-6 px-6 text-center">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900">Frigate Review</h1>
        <p class="text-lg text-slate-600">
            Self-hosted detection review for your Frigate NVR.
        </p>
        <a href="{{ path('app_detection_list') }}"
           class="rounded-md bg-slate-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-slate-700">
            Start reviewing →
        </a>
        <span class="rounded-full bg-emerald-100 px-4 py-1.5 text-sm font-medium text-emerald-800">
            Tailwind CSS is served locally through AssetMapper — no CDN, no Node runtime.
        </span>
    </main>
{% endblock %}
