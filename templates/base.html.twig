<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Frigate Review{% endblock %}</title>
    {# All assets are served locally through AssetMapper; the app never
       references external CDNs, fonts, or APIs. #}
    <link rel="stylesheet" href="{{ asset('styles/app.built.css') }}">
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="h-full font-sans text-slate-900 antialiased">
    <nav class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-5xl items-baseline gap-6 px-6 py-3 text-sm font-medium">
            <span class="text-base font-bold tracking-tight text-slate-900">Frigate Review</span>
            <a href="{{ path('app_dashboard') }}" class="text-slate-600 hover:text-slate-900">Dashboard</a>
            <a href="{{ path('app_detection_list') }}" class="text-slate-600 hover:text-slate-900">Detections</a>
        </div>
    </nav>
    {% for flashLabel in ['success', 'error'] %}
        {% for flashMessage in app.flashes(flashLabel) %}
            <div class="mx-auto max-w-5xl px-6 pt-4">
                <div class="flash-{{ flashLabel }} rounded-md border px-4 py-3 text-sm {{ flashLabel == 'success'
                    ? 'border-emerald-200 bg-emerald-50 text-emerald-800'
                    : 'border-red-200 bg-red-50 text-red-800' }}">
                    {{ flashMessage }}
                </div>
            </div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
    <footer class="mt-8 pb-6 text-center text-xs text-slate-400">frigate-reviewer — self-hosted detection review</footer>
</body>
</html>
